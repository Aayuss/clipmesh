#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION=8.13
CACHE="${HOME}/.clipmesh-tools/gradle-${GRADLE_VERSION}"
if [ ! -x "$CACHE/bin/gradle" ]; then
  mkdir -p "$(dirname "$CACHE")"
  ZIP="${HOME}/.clipmesh-tools/gradle-${GRADLE_VERSION}-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  echo "Downloading Gradle ${GRADLE_VERSION} from official Gradle distribution..."
  if command -v curl >/dev/null 2>&1; then curl -fL "$URL" -o "$ZIP"; else wget -O "$ZIP" "$URL"; fi
  rm -rf "$CACHE"
  unzip -q "$ZIP" -d "${HOME}/.clipmesh-tools"
fi
exec "$CACHE/bin/gradle" -p "$ROOT" "$@"
