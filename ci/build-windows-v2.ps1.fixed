$ErrorActionPreference = 'Stop'
Set-Location (Join-Path $PSScriptRoot '..')

cargo build --release -p clipmesh

$out = 'dist\windows'
New-Item -ItemType Directory -Force -Path $out | Out-Null

$cscCandidates = @(
    "$env:WINDIR\Microsoft.NET\Framework64\v4.0.30319\csc.exe",
    "$env:WINDIR\Microsoft.NET\Framework\v4.0.30319\csc.exe"
)
$csc = $cscCandidates | Where-Object { Test-Path $_ } | Select-Object -First 1
if (-not $csc) {
    throw 'Could not locate the .NET Framework C# compiler (csc.exe).'
}

$source = Join-Path $PSScriptRoot '..\..\ci\ClipMeshWindows.cs'
$engine = (Resolve-Path 'target\release\clipmesh.exe').Path
$icon = (Resolve-Path 'apps\desktop\assets\clipmesh.ico').Path
$exe = Join-Path (Resolve-Path $out).Path 'clipmesh.exe'

& $csc `
    /nologo `
    /optimize+ `
    /target:winexe `
    /platform:x64 `
    /out:$exe `
    /win32icon:$icon `
    /resource:"$engine,ClipMesh.Engine" `
    /reference:System.dll `
    /reference:System.Core.dll `
    /reference:System.Drawing.dll `
    /reference:System.Windows.Forms.dll `
    $source

if ($LASTEXITCODE -ne 0) {
    throw "C# launcher compilation failed with exit code $LASTEXITCODE"
}

if (-not (Test-Path $exe)) {
    throw 'Windows launcher was not produced.'
}

Write-Host "Built native Windows tray application: $exe"
